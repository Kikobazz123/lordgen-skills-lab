# Cloudflare Workers AI (FLUX.1 Schnell image generation) — used by lordgen-pitch/scripts/render_illustration.py
# Free tier: 10,000 Neurons/day, no credit card required.
# Account ID: Cloudflare dashboard right sidebar (not secret, but required in the API URL).
# API Token: https://dash.cloudflare.com/profile/api-tokens -> Create Token -> "Workers AI" template (or custom with Account.Workers AI Read/Edit).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Perplexity (Sonar API) — research tool for tool-scout, alongside WebSearch.
# Get a key at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=
